{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/query",
      "destination": "/api/proxy"
    },
    {
      "source": "/ingest/(.*)",
      "destination": "/api/proxy"
    },
    {
      "source": "/graph/(.*)",
      "destination": "/api/proxy"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}

